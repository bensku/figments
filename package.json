{
    "name": "bun-react-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot src/index.ts",
        "run": "NODE_ENV=production bun src/index.ts",
        "format": "biome format --write",
        "lint": "biome lint --write",
        "typecheck": "tsc --noEmit",
        "check": "biome check --write && tsc --noEmit"
    },
    "dependencies": {
        "@ai-sdk/amazon-bedrock": "^4.0.93",
        "@ai-sdk/anthropic": "^3.0.58",
        "@ai-sdk/baseten": "^1.0.44",
        "@ai-sdk/devtools": "^0.0.5",
        "@ai-sdk/google-vertex": "^4.0.28",
        "@ai-sdk/openai": "^3.0.12",
        "@ai-sdk/openai-compatible": "^2.0.13",
        "@aws-sdk/client-s3": "^3.954.0",
        "@bensku/y-query": "^0.0.8",
        "@bensku/y-query-react": "^0.0.8",
        "@hocuspocus/extension-database": "^3.4.3",
        "@hocuspocus/provider": "^3.4.3",
        "@hocuspocus/server": "^3.4.3",
        "@tailwindcss/typography": "^0.5.19",
        "ai": "^6.0.116",
        "bun-plugin-tailwind": "^0.1.2",
        "lucide-react": "^0.562.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "tailwindcss": "^4.1.18",
        "tinykeys": "^3.0.0",
        "wouter": "^3.9.0",
        "yjs": "^13.6.28",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@types/bun": "latest",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "msw": "^2.12.4",
        "vitest": "^4.0.16"
    }
}

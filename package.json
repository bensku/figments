{
    "name": "bun-react-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot src/index.ts",
        "run": "NODE_ENV=production bun src/index.ts",
        "format": "biome format --write",
        "lint": "biome lint --write",
        "typecheck": "tsc --noEmit",
        "check": "biome check --write && tsc --noEmit"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^2.0.56",
        "@aws-sdk/client-s3": "^3.954.0",
        "@bensku/y-query": "^0.0.8",
        "@bensku/y-query-react": "^0.0.8",
        "@hocuspocus/extension-s3": "^3.4.3",
        "@hocuspocus/provider": "^3.4.3",
        "@hocuspocus/server": "^3.4.3",
        "ai": "^5.0.115",
        "bun-plugin-tailwind": "^0.1.2",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-markdown": "^10.1.0",
        "tailwindcss": "^4.1.18",
        "wouter": "^3.9.0",
        "yjs": "^13.6.28",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@types/bun": "latest",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "msw": "^2.12.4",
        "vitest": "^4.0.16"
    }
}
